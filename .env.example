# =========================================================
# B-VAULT ENVIRONMENT VARIABLES
# Salin file ini ke .env.local untuk development lokal
# dan masukkan ke Environment Variables di Cloudflare Pages
# =========================================================

# 1. Supabase Database (Dapatkan di: Supabase -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Google OAuth 2.0 Credentials
# Dapatkan dari Google Cloud Console -> APIs & Services -> Credentials
# Authorized redirect URI: http://localhost:3000/api/v1/auth/google/callback (atau domain cloudflare)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 3. Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
